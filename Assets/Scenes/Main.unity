--- !u!114 &1983930223
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1983930222}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 43e686a870679ce4e9111a4ee601a6dc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  tutorialPanel: {fileID: 1497207772}
  tutorialText: {fileID: 2068539063}
  steps:
  - instructionText: "\u0E1A\u0E32\u0E07\u0E04\u0E23\u0E31\u0E49\u0E07\u0E01\u0E32\u0E23\u0E40\u0E14\u0E34\u0E19\u0E01\u0E47\u0E0A\u0E49\u0E32\u0E40\u0E01\u0E34\u0E19\u0E44\u0E1B
      \u0E25\u0E2D\u0E07\u0E01\u0E14 [Shift] \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E27\u0E34\u0E48\u0E07\u0E2A\u0E34"
    keyToPress: 304
  - instructionText: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E28\u0E31\u0E15\u0E23\u0E39\u0E1E\u0E38\u0E48\u0E07\u0E40\u0E02\u0E49\u0E32\u0E21\u0E32\u0E2B\u0E32
      \u0E01\u0E14 [Spacebar] \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E1E\u0E38\u0E48\u0E07\u0E2B\u0E25\u0E1A\u0E01\u0E32\u0E23\u0E42\u0E08\u0E21\u0E15\u0E35!"
    keyToPress: 32
  - instructionText: "\u0E2B\u0E22\u0E34\u0E1A\u0E2D\u0E32\u0E27\u0E38\u0E18\u0E02\u0E36\u0E49\u0E19\u0E21\u0E32!
      \u0E01\u0E14 [\u0E04\u0E25\u0E34\u0E01\u0E0B\u0E49\u0E32\u0E22] \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E42\u0E08\u0E21\u0E15\u0E35\u0E41\u0E1A\u0E1A\u0E23\u0E27\u0E14\u0E40\u0E23\u0E47\u0E27
      (\u0E15\u0E35\u0E40\u0E1A\u0E32)"
    keyToPress: 323
  - instructionText: "\u0E2B\u0E32\u0E01\u0E15\u0E49\u0E2D\u0E07\u0E01\u0E32\u0E23\u0E2A\u0E23\u0E49\u0E32\u0E07\u0E04\u0E27\u0E32\u0E21\u0E40\u0E2A\u0E35\u0E22\u0E2B\u0E32\u0E22\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E2B\u0E19\u0E31\u0E01
      \u0E43\u0E2B\u0E49\u0E01\u0E14 [\u0E04\u0E25\u0E34\u0E01\u0E02\u0E27\u0E32]
      \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E07\u0E49\u0E32\u0E07\u0E42\u0E08\u0E21\u0E15\u0E35
      (\u0E15\u0E35\u0E41\u0E23\u0E07)"
    keyToPress: 324
  - instructionText: "\u0E40\u0E21\u0E37\u0E48\u0E2D\u0E40\u0E08\u0E2D\u0E2A\u0E34\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E2B\u0E23\u0E37\u0E2D\u0E01\u0E25\u0E48\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E02\u0E27\u0E32\u0E07\u0E17\u0E32\u0E07
      \u0E01\u0E14 [E] \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E2A\u0E33\u0E23\u0E27\u0E08
      \u0E2B\u0E23\u0E37\u0E2D\u0E01\u0E14\u0E04\u0E49\u0E32\u0E07\u0E44\u0E27\u0E49\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E25\u0E32\u0E01\u0E2A\u0E34\u0E48\u0E07\u0E02\u0E2D\u0E07\u0E19\u0E31\u0E49\u0E19"
    keyToPress: 101
  - instructionText: "\u0E15\u0E23\u0E27\u0E08\u0E2A\u0E2D\u0E1A\u0E40\u0E2A\u0E1A\u0E35\u0E22\u0E07\u0E41\u0E25\u0E30\u0E02\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E2B\u0E32\u0E21\u0E32\u0E44\u0E14\u0E49
      \u0E42\u0E14\u0E22\u0E01\u0E14\u0E1B\u0E38\u0E48\u0E21 [I] \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E1B\u0E34\u0E14\u0E01\u0E23\u0E30\u0E40\u0E1B\u0E4B\u0E32\u0E40\u0E01\u0E47\u0E1A\u0E02\u0E2D\u0E07"
    keyToPress: 105
  - instructionText: "\u0E15\u0E23\u0E27\u0E08\u0E2A\u0E2D\u0E1A\u0E40\u0E2A\u0E1A\u0E35\u0E22\u0E07\u0E41\u0E25\u0E30\u0E02\u0E2D\u0E07\u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E2B\u0E32\u0E21\u0E32\u0E44\u0E14\u0E49
      \u0E42\u0E14\u0E22\u0E01\u0E14\u0E1B\u0E38\u0E48\u0E21 [I] \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E1B\u0E34\u0E14\u0E01\u0E23\u0E30\u0E40\u0E1B\u0E4B\u0E32\u0E40\u0E01\u0E47\u0E1A\u0E02\u0E2D\u0E07"
    keyToPress: 105
  - instructionText: "\u0E1A\u0E31\u0E19\u0E17\u0E36\u0E01\u0E41\u0E25\u0E30\u0E40\u0E1A\u0E32\u0E30\u0E41\u0E2A\u0E15\u0E48\u0E32\u0E07\u0E46
      \u0E17\u0E35\u0E48\u0E04\u0E38\u0E13\u0E40\u0E01\u0E47\u0E1A\u0E44\u0E14\u0E49
      \u0E08\u0E30\u0E16\u0E39\u0E01\u0E40\u0E01\u0E47\u0E1A\u0E44\u0E27\u0E49\u0E43\u0E19\u0E40\u0E2D\u0E01\u0E2A\u0E32\u0E23
      \u0E01\u0E14 [J] \u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E1B\u0E34\u0E14\u0E2D\u0E48\u0E32\u0E19\u0E21\u0E31\u0E19"
    keyToPress: 106
  forceShowTutorial: 1
