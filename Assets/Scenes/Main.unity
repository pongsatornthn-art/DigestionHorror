  fallbackGreeting: "\u0E44\u0E21\u0E48\u0E21\u0E35\u0E2D\u0E30\u0E44\u0E23\u0E43\u0E2B\u0E49\u0E40\u0E08\u0E49\u0E32\u0E17\u0E33\u0E41\u0E25\u0E49\u0E27\u0E25\u0E48\u0E30\u0E44\u0E2D\u0E49\u0E2B\u0E19\u0E38\u0E48\u0E21..."
  dialoguePanel: {fileID: 1971511454}
